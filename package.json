{
    "name": "ma-ui",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter @ma-ui/tailwind build && bun run --filter @ma-ui/storybook dev",
        "build": "bun run --filter '*' build",
        "registry:build": "bun run --filter @ma-ui/registry build",
        "shadcn:import": "bun packages/registry/scripts/shadcn-import.ts",
        "test": "bun run --filter '*' test",
        "typecheck": "bun run --filter '*' typecheck",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "check": "bun run typecheck && bun run test && bun run format:check && bun run lint"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tailwindcss": "^4.3.3",
        "typescript": "^7"
    }
}
